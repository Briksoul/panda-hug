# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_FAST_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096

# Authentication and database
# Local development:
DATABASE_URL=sqlite:///./data/pandahug.db
# CloudBase Serverless MySQL:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@PRIVATE_HOST:3306/DATABASE?charset=utf8mb4
# CloudBase PostgreSQL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@172.17.0.2:5432/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_HOURS=168
AUTH_COOKIE_SECURE=false

# Hume EVI
HUME_API_KEY=
HUME_SECRET_KEY=
HUME_CONFIG_ID=
HUME_TOKEN_PROXY_URL=
HUME_TOKEN_PROXY_SECRET=

# Knowledge base
USE_CHROMA=true
KNOWLEDGE_BASE_DIR=
CHROMA_PERSIST_DIR=./data/chromadb
